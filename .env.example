# Copy to .env.local (gitignored) and fill in only what you need. Every value is optional.

# Port for pnpm dev / pnpm start / pnpm serve (default 3000). The app always binds 127.0.0.1.
PORT=

# Data folder holding app.db and the image folders (default ./data, relative to the project root).
DATA_DIR=

# Path of the local secrets file (default ./secrets.json at the project root, outside the data folder).
SECRETS_FILE=

# Discogs app consumer key; overrides the value saved on the Settings page.
DISCOGS_CONSUMER_KEY=

# Discogs app consumer secret; overrides the value saved on the Settings page.
DISCOGS_CONSUMER_SECRET=

# Path to the Claude Code CLI binary (default: `claude` on PATH). Vision uses your Claude subscription, no API key.
CLAUDE_BIN=

# Set to 1 to enable the dev-only test-job routes and card under pnpm start (used by the verify scripts).
APP_TEST_HOOKS=

# Test only: base URL of a fake Discogs API (verify scripts). Ignored unless https, or http on 127.0.0.1 or localhost.
DISCOGS_API_BASE=

# Test only: base URL of a fake discogs.com authorize page. Same https or loopback-http rule.
DISCOGS_WEB_BASE=

# Test only: base URL of fake Discogs images. Same https or loopback-http rule.
DISCOGS_IMAGE_BASE=
