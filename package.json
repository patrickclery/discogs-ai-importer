{
  "name": "discogs-ai-importer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "start": "next build && next start -H 127.0.0.1 -p 3001",
    "serve": "next start -H 127.0.0.1 -p 3001",
    "build": "next build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "spike:vision": "vitest run --config vitest.spike.config.ts",
    "db:generate": "drizzle-kit generate",
    "demo:assets": "vitest run --config vitest.demo.config.ts scripts/demo/build-assets.demo.ts",
    "demo:record": "DEMO_RECORD=1 vitest run --config vitest.demo.config.ts scripts/demo/record-discogs.demo.ts",
    "demo:covers": "vitest run --config vitest.demo.config.ts scripts/demo/build-covers.demo.ts",
    "demo:build": "node scripts/demo/build-demo.ts",
    "demo:smoke": "node scripts/demo/smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "heic-decode": "2.1.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
